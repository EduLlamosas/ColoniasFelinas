generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoSuelo {
  URBANO
  RURAL
  INDUSTRIAL
}

enum Sexo {
  MACHO
  HEMBRA
  DESCONOCIDO
}

enum EstadoCer {
  AVISTADO
  CAPTURADO
  ESTERILIZADO
  RETORNADO
  ADOPTADO
}

enum RolUsuario {
  ADMINISTRADOR
  GESTOR
}

enum TipoEventoClinico {
  ESTERILIZACION
  VACUNACION
  TEST_ENFERMEDAD
  TRATAMIENTO_ESPECIAL
}

// Entidad raíz del multi-tenant: un Ayuntamiento/cliente. Todo el resto de datos (usuarios,
// colonias y lo que cuelga de ellas) pertenece a exactamente una Organizacion, aislado de las
// demás por Row-Level Security en Postgres (ver la migración de introducción de este modelo para
// las políticas concretas) - el filtrado NO depende de que cada resolver se acuerde de un `where`,
// es la propia base de datos la que rechaza filas de otra organización.
model Organizacion {
  id        Int      @id @default(autoincrement())
  nombre    String
  slug      String   @unique @db.VarChar(80)
  activo    Boolean  @default(true)
  // En KB, no bytes: un Int (máx. ~2^31) se queda corto en bytes para una cuota de varios GB,
  // pero en KB llega sin problema hasta el rango de los TB - de sobra para esta cuota. Lo
  // mantiene uploads.controller.ts en cada subida/borrado (ver StorageService) - no es una suma
  // recalculada bajo demanda contra el propio proveedor de almacenamiento.
  storageKbUsados Int      @default(0) @map("storage_kb_usados")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios    Usuario[]
  colonias    Colonia[]
  voluntarios Voluntario[]

  @@map("organizaciones")
}

model Usuario {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  passwordHash   String     @map("password_hash")
  nombreCompleto String     @map("nombre_completo")
  rol            RolUsuario @default(GESTOR)
  // NULL = superadmin (el operador del propio SaaS, no pertenece a ningún ayuntamiento - ver
  // SuperadminGuard). Todo el resto de usuarios pertenece exactamente a una Organizacion. La
  // política RLS de esta tabla usa app.is_superadmin, no este campo, para decidir si un superadmin
  // ve las filas de todas las organizaciones.
  organizacionId Int?          @map("organizacion_id")
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  // Incluido en el payload del JWT al firmarlo y comprobado en JwtStrategy en cada petición: un
  // UPDATE que lo incremente ("token_version = token_version + 1") invalida de golpe todos los
  // tokens ya emitidos para este usuario (dispositivo perdido, token compartido por error...),
  // sin esperar a que expiren solos ni necesitar una lista de revocación aparte.
  tokenVersion   Int        @default(0) @map("token_version")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  visitasComedero   VisitaComedero[]
  registrosClinicos RegistroClinico[]

  @@index([organizacionId])
  @@map("usuarios")
}

model Colonia {
  id             Int          @id @default(autoincrement())
  organizacionId Int          @map("organizacion_id")
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  codigoOficial  String?      @unique @map("codigo_oficial")
  nombre         String
  tipoSuelo      TipoSuelo    @map("tipo_suelo")
  latitud        Float
  longitud       Float
  observaciones  String?
  fotoUrl        String?      @map("foto_url")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  comederos    Comedero[]
  gatos        Gato[]
  asignaciones AsignacionVoluntario[]

  @@index([organizacionId])
  @@map("colonias")
}

model Comedero {
  id                 Int      @id @default(autoincrement())
  // Copiado de Colonia.organizacionId en el momento de crear (no es una FK a Organizacion propia,
  // es la misma denormalización que en el resto de tablas hijas) - así la política RLS de esta
  // tabla filtra por una columna propia en vez de necesitar un JOIN contra colonias en cada fila.
  organizacionId     Int      @map("organizacion_id")
  coloniaId          Int      @map("colonia_id")
  ubicacionDetallada String   @map("ubicacion_detallada")
  fotoUrl            String?  @map("foto_url")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  colonia Colonia          @relation(fields: [coloniaId], references: [id], onDelete: Cascade)
  visitas VisitaComedero[]

  @@index([coloniaId])
  @@index([organizacionId])
  @@map("comederos")
}

model VisitaComedero {
  id             Int      @id @default(autoincrement())
  // Copiado de Comedero.organizacionId al crear - mismo motivo que en Comedero (RLS sin JOIN).
  organizacionId Int      @map("organizacion_id")
  comederoId    Int      @map("comedero_id")
  // Nullable a nivel de columna solo para no romper filas ya existentes al añadir el campo
  // (ALTER TABLE ADD COLUMN NOT NULL falla contra una tabla con datos sin un default). El
  // resolver SIEMPRE lo rellena a partir del JWT en toda escritura nueva - nunca es un campo
  // que el cliente pueda mandar, así nadie puede registrar un evento en nombre de otro usuario.
  usuarioId     Int?     @map("usuario_id")
  piensoSeco    Boolean  @default(false) @map("pienso_seco")
  comidaHumeda  Boolean  @default(false) @map("comida_humeda")
  agua          Boolean  @default(false)
  observaciones String?
  // UUID generado por el cliente al pulsar "Confirmar registro" - la app móvil reintenta esta
  // mutación sola cuando recupera conexión (cola offline), y si la petición original SÍ llegó a
  // procesarse pero la respuesta se perdió por el camino, el reintento manda la MISMA clave: el
  // servicio la detecta y devuelve la fila ya existente en vez de duplicarla. Nullable porque las
  // filas ya existentes (creadas antes de este campo) no tienen ninguna que asignarles; NULL no
  // choca contra la unicidad porque Postgres no compara NULLs entre sí como iguales.
  idempotencyKey String? @unique @map("idempotency_key")
  createdAt     DateTime @default(now()) @map("created_at")

  comedero Comedero @relation(fields: [comederoId], references: [id], onDelete: Cascade)
  usuario  Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  // Compuesto, no dos índices simples: findByComedero() filtra por comederoId Y ordena por
  // createdAt desc - con [comederoId, createdAt] Postgres puede devolver las filas ya en ese
  // orden directamente desde el índice, sin un paso de Sort aparte una vez filtradas.
  @@index([comederoId, createdAt])
  @@index([organizacionId])
  @@map("visitas_comedero")
}

model Gato {
  id              Int       @id @default(autoincrement())
  // Copiado de Colonia.organizacionId al crear - mismo motivo que en Comedero (RLS sin JOIN).
  organizacionId  Int       @map("organizacion_id")
  coloniaId       Int       @map("colonia_id")
  nombre          String?
  sexo            Sexo
  fechaNacimiento DateTime? @map("fecha_nacimiento")
  capaPelaje      String    @map("capa_pelaje")
  estadoCer       EstadoCer @map("estado_cer")
  observaciones   String?
  tieneMicrochip  Boolean   @default(false) @map("tiene_microchip")
  numMicrochip    String?   @unique @map("num_microchip")
  marcajeOreja    Boolean   @default(false) @map("marcaje_oreja")
  fotoUrl         String?   @map("foto_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  colonia           Colonia           @relation(fields: [coloniaId], references: [id], onDelete: Restrict)
  registrosClinicos RegistroClinico[]

  @@index([coloniaId])
  @@index([organizacionId])
  @@map("gatos")
}

model RegistroClinico {
  id             Int               @id @default(autoincrement())
  // Copiado de Gato.organizacionId al crear - mismo motivo que en Comedero (RLS sin JOIN).
  organizacionId Int               @map("organizacion_id")
  gatoId      Int               @map("gato_id")
  // Mismo motivo que en VisitaComedero.usuarioId: nullable en columna, siempre relleno en la
  // práctica porque el resolver lo saca del JWT, nunca del cliente.
  usuarioId   Int?              @map("usuario_id")
  tipo        TipoEventoClinico
  fecha       DateTime
  diagnostico String
  // Mismo mecanismo y mismo motivo que VisitaComedero.idempotencyKey: la app móvil reintenta
  // esta mutación sola desde la cola offline, y esta clave evita que un reintento tras una
  // respuesta perdida (pero ya procesada) duplique el registro clínico.
  idempotencyKey String?        @unique @map("idempotency_key")
  createdAt   DateTime          @default(now()) @map("created_at")

  gato    Gato     @relation(fields: [gatoId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  // Compuesto, mismo motivo que en VisitaComedero: findByGato() filtra por gatoId Y ordena por
  // fecha desc.
  @@index([gatoId, fecha])
  @@index([organizacionId])
  @@map("registros_clinicos")
}

model Voluntario {
  id             Int          @id @default(autoincrement())
  organizacionId Int          @map("organizacion_id")
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  dni            String       @unique
  nombre         String
  telefono       String?
  urlCesionDatos String       @map("url_cesion_datos")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  asignaciones AsignacionVoluntario[]

  @@index([organizacionId])
  @@map("voluntarios")
}

model AsignacionVoluntario {
  id             Int      @id @default(autoincrement())
  // Copiado de Colonia.organizacionId al crear (voluntario y colonia siempre son de la misma
  // organización - lo comprueba el servicio, no la BD) - mismo motivo que en el resto: RLS sin JOIN.
  organizacionId Int      @map("organizacion_id")
  voluntarioId Int      @map("voluntario_id")
  coloniaId    Int      @map("colonia_id")
  rolAsignado  String   @map("rol_asignado") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  voluntario Voluntario @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)
  colonia    Colonia    @relation(fields: [coloniaId], references: [id], onDelete: Cascade)

  // Antes esta pareja era la propia clave primaria (@@id) - un voluntario no puede tener dos
  // asignaciones a la misma colonia, esa regla de negocio no cambia. Lo que cambia es que ahora la
  // identidad de la fila es "id", como en el resto de entidades, para que la API de GraphQL
  // (asignacion(id), updateAsignacion(id, ...), removeAsignacion(id)) y la caché de Apollo en el
  // cliente (que necesita una clave estable de un solo campo para normalizar) funcionen igual que
  // con cualquier otra entidad, sin el caso especial que tenían hasta ahora.
  @@unique([voluntarioId, coloniaId])
  @@index([organizacionId])
  @@map("voluntarios_colonias")
}
